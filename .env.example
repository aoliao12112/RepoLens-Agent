# Copy to .env for local use. Never commit .env.
GITHUB_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=
AGENT_REVIEW_TIMEOUT_SECONDS=45
DATABASE_URL=sqlite:///./data/repolens.db
REQUEST_TIMEOUT_SECONDS=20
REQUEST_MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=0.25
RETRY_MAX_DELAY_SECONDS=5
MAX_CONCURRENCY=4
GITHUB_MAX_PAGES=5
ACTIVITY_WINDOW_DAYS=90
ISSUE_STALE_DAYS=180
ISSUE_RESPONSE_SAMPLE_SIZE=10
CACHE_DATA_VERSION=1
CACHE_METADATA_TTL_SECONDS=900
CACHE_TREE_TTL_SECONDS=3600
CACHE_CONTENT_TTL_SECONDS=3600
CACHE_ACTIVITY_TTL_SECONDS=300
CACHE_ISSUE_TTL_SECONDS=300
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

